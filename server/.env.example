# Configuration de l'API Mantrailing sur o2switch.
# Copier ce fichier en server/.env.production (non versionné), le compléter : deploy.ps1 l'envoie sur le serveur
# sous le nom .env, à côté de package.json, où src/index.js le lit au démarrage.

# Base MySQL/MariaDB (cPanel › Bases de données MySQL ; l'utilisateur doit avoir tous les privilèges sur la base,
# les tables sont créées au premier démarrage).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gepi9588_mantrailing
DB_USER=gepi9588_mantrailing
DB_PASSWORD=

# Identifiant OAuth « Web » du projet Google (le même que mantrailing.googleWebClientId dans gradle.properties) :
# seuls les jetons Google émis pour lui sont acceptés.
GOOGLE_CLIENT_ID=1060303843038-k41u1rfk863q4kb8cvdq300eml85s73p.apps.googleusercontent.com
