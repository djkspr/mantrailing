# Configuration (secrets) de l'API Mantrailing — modèle, sans aucun secret.
#
# Sur le serveur o2switch : à poser À LA MAIN dans /home/gepi9588/.config/mantrailing/.env (hors du site et du dossier
# de l'application, jamais envoyé par deploy.ps1), droits 600 (lecture/écriture pour le seul compte d'hébergement).
# Autre emplacement possible : variable MANTRAILING_ENV_FILE.
# Sur un poste de développement : server/.env.local (non versionné), lu en premier.

# Base MySQL/MariaDB (cPanel › Bases de données MySQL ; l'utilisateur doit avoir tous les privilèges sur la base,
# les tables sont créées au premier démarrage).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gepi9588_mantrailing
DB_USER=gepi9588_mantrailing
DB_PASSWORD=

# Identifiant OAuth « Web » du projet Google (le même que mantrailing.googleWebClientId dans gradle.properties) :
# seuls les jetons Google émis pour lui sont acceptés.
GOOGLE_CLIENT_ID=1060303843038-k41u1rfk863q4kb8cvdq300eml85s73p.apps.googleusercontent.com
